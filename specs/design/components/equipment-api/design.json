{
  "name": "equipment-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "equipment-api",
  "entrypoint": "deployment/service",
  "exposure": "intranet",
  "stories": [
    "F1.1",
    "F1.2",
    "F1.3",
    "F1.4",
    "F2.1",
    "F2.2",
    "F2.3",
    "F3.1",
    "F3.2",
    "F3.3",
    "F3.4"
  ],
  "description": "Backend API for the equipment catalog and loan lifecycle: adding, editing and retiring equipment; borrowing, returning, listing and extending loans. Enforces office-manager-only inventory management and the office manager's cross-staff overdue view. Does not send notifications and does not serve any UI.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "equipment-db",
      "description": "Stores equipment, loans and their status.",
      "resourceType": "postgres-cnpg",
      "wiring": {
        "ref": "equipment-loans-e-8831b145",
        "envBindings": {
          "dbname": "EQUIPMENT_DB_DBNAME",
          "host": "EQUIPMENT_DB_HOST",
          "password": "EQUIPMENT_DB_PASSWORD",
          "port": "EQUIPMENT_DB_PORT",
          "user": "EQUIPMENT_DB_USER"
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "description": "Verifies the signed gateway assertion for every protected operation.",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "equipment-loans-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
